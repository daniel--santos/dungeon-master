{
  "name": "@dungeon-master/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Processo Node do Worker: fila de Runs, execução pelo runtime e escrita do desfecho.",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "dm": "tsx scripts/dm.ts"
  },
  "dependencies": {
    "@dungeon-master/achievements": "workspace:*",
    "@dungeon-master/context": "workspace:*",
    "@dungeon-master/contracts": "workspace:*",
    "@dungeon-master/database": "workspace:*",
    "@dungeon-master/events": "workspace:*",
    "@dungeon-master/knowledge": "workspace:*",
    "@dungeon-master/platform": "workspace:*",
    "@dungeon-master/runs": "workspace:*",
    "@dungeon-master/runtime": "workspace:*",
    "@dungeon-master/runtime-antigravity": "workspace:*",
    "@dungeon-master/runtime-sandcastle": "workspace:*",
    "@dungeon-master/workflow": "workspace:*",
    "dotenv": "17.4.2",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3"
  },
  "devDependencies": {
    "@dungeon-master/tooling-vitest": "workspace:*",
    "@types/node": "26.5.0",
    "@types/pg": "8.23.1",
    "drizzle-orm": "0.45.2",
    "pg": "8.23.0",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vitest": "5.0.0",
    "zod": "4.5.4"
  }
}
