# Copie para `.env` na raiz do monorepo ou exporte no ambiente.
# O `.env` da raiz vale para todos os processos; um `.env` neste diretório
# sobrepõe o da raiz, variável a variável.

DATABASE_URL=postgresql://dungeon:dungeon@127.0.0.1:5433/dungeon_master

NODE_ENV=development
LOG_LEVEL=info

# Intervalo entre tentativas de reclamar da fila, em milissegundos. O caminho
# rápido é o NOTIFY do trigger de `run`; este tique é a rede de segurança para
# uma notificação perdida e o relógio do observador de cancelamento.
WORKER_TICK_INTERVAL_MS=1000

# Teto de Runs em execução ao mesmo tempo neste processo. Cada Run é um agente
# de verdade, com CPU e memória de verdade.
WORKER_MAX_CONCURRENT_RUNS=2

# Quanto o desligamento gracioso espera pelos Runs em voo depois de mandar
# cancelar. O kill de árvore no Windows confirma por polling, e um agente no
# meio de uma escrita em disco merece a chance de sair inteiro.
WORKER_SHUTDOWN_TIMEOUT_MS=30000

# Silêncio máximo de um agente antes do timeout de ociosidade.
WORKER_RUN_IDLE_TIMEOUT_MS=600000

# Teto absoluto de uma execução, do spawn ao evento terminal.
WORKER_RUN_COMPLETION_TIMEOUT_MS=3600000

# Onde ficam os worktrees por Run. Vazio usa
# `<pai do repositório>/.dm-worktrees/<nome do repositório>`, que é fora da
# árvore de trabalho de propósito: um worktree dentro do repositório aparece em
# `git status`, entra em `git clean -xdf` e é varrido por watcher de build.
# WORKER_WORKTREES_ROOT=
