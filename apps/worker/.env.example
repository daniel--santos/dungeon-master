# Copie para `.env` na raiz do monorepo ou exporte no ambiente.

DATABASE_URL=postgresql://dungeon:dungeon@127.0.0.1:5433/dungeon_master

NODE_ENV=development
LOG_LEVEL=info

# Intervalo do laço ocioso, em milissegundos. Ainda não há fila: o laço só
# registra que está vivo. Vira o polling transacional na Fase 2.
WORKER_TICK_INTERVAL_MS=15000

# Segundos que o shutdown espera pelo trabalho em andamento antes de desistir.
WORKER_SHUTDOWN_TIMEOUT_MS=10000
