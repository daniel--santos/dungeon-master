{
  "name": "@dungeon-master/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Control Plane do Dungeon Master: React 19, Vite, Tailwind, shadcn/ui e TanStack.",
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.e2e.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "dev": "vite",
    "preview": "vite preview",
    "e2e": "turbo run build --filter=@dungeon-master/api... --filter=@dungeon-master/web... && node ./e2e/run-e2e.mjs"
  },
  "dependencies": {
    "@dagrejs/dagre": "3.1.1",
