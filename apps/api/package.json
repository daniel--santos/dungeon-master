    "@hono/zod-openapi": "1.6.3",
    "dotenv": "17.4.2",
    "hono": "4.13.7",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "26.5.0",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vitest": "5.0.0"
