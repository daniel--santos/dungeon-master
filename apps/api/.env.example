# Copie para `.env` na raiz do monorepo ou exporte no ambiente.
# O `.env` da raiz vale para todos os processos; um `.env` neste diretório
# sobrepõe o da raiz, variável a variável.

# A API escuta somente em loopback (planejamento v0.4, decisões de partida da Fase 0).
API_HOST=127.0.0.1
API_PORT=3333

# Banco de desenvolvimento do docker-compose.yml na raiz.
DATABASE_URL=postgresql://dungeon:dungeon@127.0.0.1:5433/dungeon_master

# `development` liga o log legível do pino; qualquer outro valor usa JSON.
NODE_ENV=development
LOG_LEVEL=info

# Timeouts do servidor Node, em milissegundos. Existem por causa do SSE:
# uma Expedição pode manter a conexão aberta por dezenas de minutos.
# 0 em API_REQUEST_TIMEOUT_MS desliga o limite de duração da requisição.
API_REQUEST_TIMEOUT_MS=0
API_HEADERS_TIMEOUT_MS=65000
API_KEEP_ALIVE_TIMEOUT_MS=61000

# Intervalo do comentário de heartbeat do SSE; 0 desliga. Precisa ficar bem
# abaixo do timeout de qualquer proxy no caminho, senão uma conexão sem eventos
# por alguns minutos é cortada e o browser reconecta sem necessidade.
API_SSE_HEARTBEAT_MS=15000

# Tique de segurança do drain do SSE. O caminho normal é o NOTIFY acordando o
# drain na hora; este intervalo cobre a notificação perdida, por exemplo durante
# a reconexão da conexão dedicada do LISTEN.
API_SSE_FALLBACK_INTERVAL_MS=5000
