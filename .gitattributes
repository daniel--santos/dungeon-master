# LF em toda a árvore de trabalho, nos dois sistemas operacionais.
#
# Sem isto, o Windows faz checkout com CRLF e os artefatos gerados (openapi.json,
# schema.d.ts, migrações) passam a diferir por fim de linha entre Windows e
# macOS. `pnpm gen:check` e `pnpm db:check` comparam com `git diff` e ficariam
# dependentes da plataforma.
* text=auto eol=lf

# Binários nunca são convertidos.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.pdf binary

# Artefatos gerados: não contam no diff de linguagem do GitHub e não devem
# aparecer em revisão como código escrito à mão.
pnpm-lock.yaml linguist-generated=true -diff
packages/api-client/openapi.json linguist-generated=true
packages/api-client/src/schema.d.ts linguist-generated=true
apps/web/src/routeTree.gen.ts linguist-generated=true
packages/database/drizzle/meta/** linguist-generated=true
