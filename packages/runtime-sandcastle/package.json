{
  "name": "@dungeon-master/runtime-sandcastle",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Adapters de Claude Code, Codex e Pi para execução no host.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "demo": "tsc -p tsconfig.build.json && node --experimental-strip-types scripts/demo.ts"
  },
  "dependencies": {
    "@dungeon-master/contracts": "workspace:*",
    "@dungeon-master/platform": "workspace:*",
    "@dungeon-master/runtime": "workspace:*"
  },
  "devDependencies": {
    "@dungeon-master/tooling-vitest": "workspace:*",
    "@types/node": "26.5.0",
    "typescript": "6.0.3",
    "vitest": "5.0.0",
    "zod": "4.5.4"
  }
}
