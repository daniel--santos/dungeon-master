{
  "name": "@dungeon-master/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Schemas Zod: fonte única de tipos, validação e spec OpenAPI.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "4.5.4"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "vitest": "5.0.0"
  }
}
