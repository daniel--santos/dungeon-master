{
  "name": "@dungeon-master/workflow",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Motor de execução de Workflows: runner determinístico e um executor por tipo de step.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@dungeon-master/contracts": "workspace:*",
    "@dungeon-master/domain": "workspace:*",
    "@dungeon-master/platform": "workspace:*",
    "@dungeon-master/runtime": "workspace:*"
  },
  "devDependencies": {
    "@dungeon-master/tooling-vitest": "workspace:*",
    "@types/node": "26.5.0",
    "typescript": "6.0.3",
    "vitest": "5.0.0"
  }
}
