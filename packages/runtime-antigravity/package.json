{
  "name": "@dungeon-master/runtime-antigravity",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Adapter do Antigravity CLI (agy) para execução no host.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./src/testing/index.ts",
      "default": "./src/testing/index.ts"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src/testing"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@dungeon-master/contracts": "workspace:*",
    "@dungeon-master/runtime": "workspace:*",
    "@dungeon-master/runtime-sandcastle": "workspace:*"
  },
  "devDependencies": {
    "@dungeon-master/tooling-vitest": "workspace:*",
    "@types/node": "26.5.0",
    "typescript": "6.0.3",
    "vitest": "5.0.0",
    "zod": "4.5.4"
  }
}
