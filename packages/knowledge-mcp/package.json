{
  "name": "@dungeon-master/knowledge-mcp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Servidor MCP somente leitura do Grimório, por stdio, escopado a um Project e a um usuário.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/bundle.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@dungeon-master/context": "workspace:*",
    "@dungeon-master/contracts": "workspace:*",
    "@dungeon-master/database": "workspace:*",
    "@modelcontextprotocol/sdk": "1.30.0",
    "drizzle-orm": "0.45.2",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "26.5.0",
    "esbuild": "0.28.2",
    "typescript": "6.0.3",
    "vitest": "5.0.0"
  }
}
