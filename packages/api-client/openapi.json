{
  "openapi": "3.1.0",
  "info": {
    "title": "Dungeon Master API",
    "version": "0.0.0",
    "description": "Control Plane do Dungeon Master. Erros seguem a RFC 9457 (`application/problem+json`). Todos os instantes são UTC.",
    "license": {
      "name": "MIT",
      "url": "https://opensource.org/licenses/MIT"
    }
  },
  "servers": [
    {
      "url": "http://127.0.0.1:3333",
      "description": "Desenvolvimento local"
    }
  ],
  "tags": [
    {
      "name": "system",
      "description": "Saúde, versão e documentação."
    },
    {
      "name": "events",
      "description": "Stream SSE de eventos de dashboard."
    },
    {
      "name": "settings",
      "description": "Configurações do usuário local."
    }
  ],
  "components": {
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "$ref": "#/components/schemas/HealthStatus"
          },
          "service": {
            "type": "string",
            "description": "Nome do processo que respondeu."
          },
          "version": {
            "type": "string",
            "description": "Versão do pacote da API."
          },
          "uptimeSeconds": {
            "type": "number",
            "minimum": 0,
            "description": "Segundos desde o boot do processo."
          },
          "checkedAt": {
            "type": "string",
            "format": "date-time",
            "description": "Instante da checagem, em UTC (ISO 8601)."
          },
          "database": {
            "$ref": "#/components/schemas/DatabaseHealth"
          }
        },
        "required": [
          "status",
          "service",
          "version",
          "uptimeSeconds",
          "checkedAt",
          "database"
        ],
        "description": "Saúde da API e de suas dependências."
      },
      "HealthStatus": {
        "type": "string",
        "enum": [
          "ok",
          "degraded"
        ]
      },
      "DatabaseHealth": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "description": "Verdadeiro quando o `SELECT 1` respondeu."
          },
          "latencyMs": {
            "type": "integer",
            "minimum": 0,
            "description": "Tempo da consulta, em milissegundos."
          },
          "error": {
            "type": [
              "string",
              "null"
            ],
            "description": "Mensagem do erro quando a consulta falhou; nulo caso contrário."
          }
        },
        "required": [
          "ok",
          "latencyMs",
          "error"
        ],
        "description": "Estado da conexão com o banco."
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "description": "URI que identifica o tipo do problema. `about:blank` quando genérico."
          },
          "title": {
            "type": "string",
            "description": "Resumo curto e estável do tipo do problema."
          },
          "status": {
            "type": "integer",
            "minimum": 100,
            "maximum": 599,
            "description": "Código HTTP da resposta."
          },
          "detail": {
            "type": "string",
            "description": "Explicação específica desta ocorrência."
          },
          "instance": {
            "type": "string",
            "description": "URI da ocorrência: o caminho da requisição."
          },
          "requestId": {
            "type": "string",
            "description": "Identificador da requisição, para casar com os logs."
          },
          "errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ValidationIssue"
            },
            "description": "Presente quando a validação de entrada falhou."
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "instance"
        ],
        "description": "Erro no formato RFC 9457 (`application/problem+json`)."
      },
      "ValidationIssue": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "Caminho do campo com problema, em notação de ponto. Vazio para a raiz."
          },
          "message": {
            "type": "string",
            "description": "Descrição legível do problema."
          },
          "code": {
            "type": "string",
            "description": "Código do problema, vindo do schema Zod."
          }
        },
        "required": [
          "path",
          "message",
          "code"
        ]
      },
      "PingEventResponse": {
        "type": "object",
        "properties": {
          "event": {
            "$ref": "#/components/schemas/DashboardEvent"
          }
        },
        "required": [
          "event"
        ],
        "description": "O evento `system.ping` recém-gravado."
      },
      "DashboardEvent": {
        "type": "object",
        "properties": {
          "sequence": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "description": "Cursor do evento. Estritamente crescente; é o `id` do evento SSE."
          },
          "type": {
            "type": "string",
            "description": "Tipo do evento. Os emitidos hoje estão em `DashboardEventType`."
          },
          "payload": {
            "description": "Dados do evento, em JSON. A forma depende do `type`."
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "Instante da gravação, em UTC (ISO 8601)."
          }
        },
        "required": [
          "sequence",
          "type",
          "createdAt"
        ],
        "description": "Um evento entregue pelo stream SSE."
      },
      "UserSettings": {
        "type": "object",
        "properties": {
          "ui.theme": {
            "$ref": "#/components/schemas/UiTheme"
          }
        },
        "required": [
          "ui.theme"
        ],
        "description": "Configurações do usuário com os padrões já aplicados."
      },
      "UiTheme": {
        "type": "string",
        "enum": [
          "dnd",
          "plain"
        ],
        "description": "Glossário ativo da interface."
      },
      "UpdateUserSetting": {
        "type": "object",
        "properties": {
          "value": {
            "description": "Novo valor da configuração. Validado pelo schema da chave."
          }
        },
        "description": "Novo valor de uma configuração."
      }
    },
    "parameters": {}
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Saúde da API",
        "description": "Reporta o estado do processo e o resultado de um `SELECT 1` no PostgreSQL. Responde 200 mesmo com o banco fora, com `status: degraded`, para que a diferença entre 'processo caiu' e 'dependência caiu' fique visível.",
        "responses": {
          "200": {
            "description": "Estado atual da API e do banco.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "500": {
            "description": "Falha inesperada.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/events/stream": {
      "get": {
        "tags": [
          "events"
        ],
        "summary": "Stream SSE de eventos de dashboard",
        "description": "Abre um `text/event-stream`. Envia primeiro o replay a partir do cursor e depois os eventos ao vivo. O `id` de cada evento é o `sequence`, que o cliente devolve em `since` (ou no `Last-Event-ID`) para reconectar sem perder nem repetir. Um comentário de heartbeat sai a cada 15 s.",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "maxLength": 19,
              "pattern": "^\\d+$",
              "description": "Último `sequence` que o cliente já tem. Ausente ou `0` significa 'não tenho nada'. O header `Last-Event-ID` tem precedência sobre este valor."
            },
            "required": false,
            "description": "Último `sequence` que o cliente já tem. Ausente ou `0` significa 'não tenho nada'. O header `Last-Event-ID` tem precedência sobre este valor.",
            "name": "since",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "description": "Reenviado pelo `EventSource` na reconexão. Tem precedência sobre `since`."
            },
            "required": false,
            "description": "Reenviado pelo `EventSource` na reconexão. Tem precedência sobre `since`.",
            "name": "last-event-id",
            "in": "header"
          }
        ],
        "responses": {
          "200": {
            "description": "Stream aberto. Cada `data:` é um `DashboardEvent` serializado.",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string",
                  "description": "Quadros SSE, um `DashboardEvent` em JSON por `data:`."
                }
              }
            }
          },
          "400": {
            "description": "Cursor inválido.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/events/ping": {
      "post": {
        "tags": [
          "events"
        ],
        "summary": "Grava um evento `system.ping`",
        "description": "Existe para verificar o caminho completo à mão: INSERT, NOTIFY sem payload, drain por cursor e SSE. Responde 404 quando `NODE_ENV` é `production`; a rota fica na spec de qualquer forma, para que o cliente gerado não dependa do ambiente em que a spec foi gerada.",
        "responses": {
          "201": {
            "description": "Evento gravado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PingEventResponse"
                }
              }
            }
          },
          "404": {
            "description": "Endpoint desligado em produção.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/settings": {
      "get": {
        "tags": [
          "settings"
        ],
        "summary": "Configurações do usuário",
        "description": "Devolve todas as chaves conhecidas, com os padrões aplicados sobre o que estiver gravado em `user_setting`. Nenhuma chave falta na resposta.",
        "responses": {
          "200": {
            "description": "Configurações atuais.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserSettings"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/settings/{key}": {
      "put": {
        "tags": [
          "settings"
        ],
        "summary": "Grava uma configuração",
        "description": "Valida o valor pelo schema da chave, faz upsert e grava um evento `settings.changed` na mesma transação. Devolve o objeto completo já atualizado, para a tela não precisar de uma segunda ida ao servidor.",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[a-z0-9][a-z0-9._-]*$",
              "description": "Chave da configuração, como gravada em `user_setting`."
            },
            "required": true,
            "description": "Chave da configuração, como gravada em `user_setting`.",
            "name": "key",
            "in": "path"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateUserSetting"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Configurações depois da escrita.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserSettings"
                }
              }
            }
          },
          "400": {
            "description": "O valor não passou no schema da chave.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "A chave não existe no contrato de configurações.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}
