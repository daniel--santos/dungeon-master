# Dependências
node_modules/
.pnpm-store/

# Saída de build
dist/
build/
*.tsbuildinfo

# Caches de ferramenta
.turbo/
.vite/
coverage/
.eslintcache
# Temporários do plugin do TanStack Router (o routeTree.gen.ts é versionado)
.tanstack/

# Ambiente local (o .env.example é versionado)
.env
.env.local
.env.*.local

# Dados de banco embutido usados em teste
.embedded-postgres/
**/.pgdata/

# Sistema operacional e editores
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Canvas de design montado (2+ MB, regenerado a partir dos .dc.html)
docs/design/**/*.html
!docs/design/**/*.dc.html

# Saída do Playwright
apps/web/test-results/
apps/web/playwright-report/
apps/web/blob-report/
apps/web/.playwright/
